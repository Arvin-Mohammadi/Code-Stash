;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DiceCatcher!"
config/description="The first warm up practice in the Godot Master Course - Jumpstart to 2D Game Development with Godot 4. It's a simple mini game that a fox tries to catch some... dice. I guess. 	"
config/version="-v1.0.0"
run/main_scene="uid://cqqmvjr3orfl1"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="uid://dtd36ev1ar74"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Dice Catcher!"

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[global_group]

stoppable=""

[input]

restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
